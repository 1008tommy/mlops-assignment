# Excludes files from `gcloud run deploy --source .` / `gcloud builds submit`
# source uploads. Mirrors .dockerignore so the Cloud Build context stays lean
# while still bundling the git-ignored model/data files from the working tree.

.gcloudignore
.git
.gitignore
.github
